# Copy to .env.local. Keep real credentials out of GitHub.
# PostgreSQL: matches compose.yaml for local development only.
DATABASE_URL=postgresql://jobhunt:jobhunt_local@localhost:15432/jobhunt_ez
POSTGRES_PORT=15432
POSTGRES_PASSWORD=jobhunt_local
APP_URL=http://localhost:3000
PORT=3000
STORAGE_DIR=./data/resumes
TRUSTED_PROXIES=

# Real email delivery requires both settings. Development otherwise saves emails in data/mail.
# Production registration fails closed without configured email delivery.
EMAIL_DELIVERY_ENABLED=false
# Development only: false skips email codes and signs up directly with a password.
# Production always requires verified email ownership.
EMAIL_VERIFICATION_REQUIRED=false
RESEND_API_KEY=
EMAIL_FROM=

# Shared limits across search, research, PDF generation and extraction.
AI_USER_HOURLY_LIMIT=5
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=200
AI_MAX_CONCURRENT=3

# Optional Google/GitHub OAuth. Buttons are hidden until the provider is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gemini is the initial default. Configure a key for AI features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Job discovery
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# OpenWeb Ninja JSearch connection for LinkedIn, Indeed and indexed Kariyer.net jobs.
OPENWEBNINJA_API_KEY=
# Optional Jooble fallback. Missing credentials skip this source.
# Legacy single-region key; defaults to US. Set country/host to match your key.
JOOBLE_API_KEY=
JOOBLE_COUNTRY=us
JOOBLE_HOST=jooble.org
# Multiple regional connections (keys must match their regional domains).
# Example: {"tr":{"apiKey":"YOUR_TR_KEY","host":"tr.jooble.org"},"gb":{"apiKey":"YOUR_UK_KEY","host":"uk.jooble.org"}}
JOOBLE_REGIONS=
# Brave Search API token for finding new company/ATS career pages.
# Known profile career URLs and saved sources work without this token.
SEARCH_API_KEY=

# Optional live browser research
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Opt in to paid JS rendering only when HTTP extraction needs it; no LLM used.
CAREER_BROWSER_FALLBACK=false

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
